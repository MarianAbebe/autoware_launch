# Estimated initial calibration for bag replay. Replace every estimated value
# below with measured sensor_kit_base_link -> sensor frame calibration values
# before deployment.
#
# Schema: parent_frame -> child_frame -> {x, y, z, roll, pitch, yaw}
# Units: x/y/z in meters, roll/pitch/yaw in radians.
sensor_kit_base_link:
  # Transform from the sensor kit root to the bag-derived Velodyne VLP-16
  # point cloud frame.
  # The child frame name must match urdf/sensor_kit.xacro.
  lidar_vlp16_points_link:
    x: 0.0 # Estimated: horizontal lever arm not measured yet.
    y: 0.0 # Estimated: horizontal lever arm not measured yet.
    z: 2.05 # Estimated from map note: GNSS antenna/map zero is ~2.05 m above ground.
    roll: 0.0 # Estimated.
    pitch: 0.0 # Estimated.
    yaw: 0.0 # Estimated.

  # Transform from the sensor kit root to bag-derived camera 0.
  cam_0_link:
    x: 0.0 # TODO: measured longitudinal offset to the cam_0 body frame.
    y: 0.0 # TODO: measured lateral offset to the cam_0 body frame.
