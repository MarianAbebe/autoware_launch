<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle" description="vehicle model name"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" description="vehicle specific ID"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>

  <arg name="lanelet2_map_file" default="lanelet2_map.osm" description="lanelet2 map file name"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd" description="pointcloud map file name"/>
  <arg name="rviz" default="false" description="launch rviz"/>

  <!-- Eng OSM shares traffic lights across many regulatory elements. Autoware's
       visualizer then emits duplicate {traffic_light_triangle,id} entries, and
       RViz MarkerArray refuses the whole Lanelet display. Dedupe → *_viz and
       use eng RViz config pointed at that topic. -->
  <include file="$(find-pkg-share autoware_launch)/launch/autoware.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="eng_loading_dock_sensor_kit"/>
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>

    <arg name="launch_vehicle" value="true"/>
    <arg name="launch_map" value="true"/>
    <arg name="launch_sensing" value="true"/>
    <arg name="launch_localization" value="true"/>
    <arg name="launch_perception" value="false"/>
    <arg name="launch_planning" value="false"/>
    <arg name="launch_control" value="false"/>
    <arg name="launch_api" value="false"/>
    <arg name="launch_system" value="false"/>

    <arg name="use_sim_time" value="true"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="launch_vehicle_interface" value="false"/>
    <arg name="system_run_mode" value="logging_simulation"/>
    <arg name="launch_system_monitor" value="false"/>
    <arg name="launch_dummy_diag_publisher" value="false"/>
    <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
    <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
    <arg name="launch_sensing_driver" value="false"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg
      name="rviz_config"
      value="$(find-pkg-share eng_loading_dock_sensor_kit_launch)/config/eng_loading_dock.rviz"
    />

    <!-- Match logging_simulator.launch.xml pose-init wiring for bag replay. -->
    <arg
      name="pose_initializer_param_path"
      value="$(find-pkg-share eng_loading_dock_sensor_kit_launch)/config/pose_initializer.eng_loading_dock.param.yaml"
    />
    <arg
      name="ndt_scan_matcher_param_path"
      value="$(find-pkg-share eng_loading_dock_sensor_kit_launch)/config/ndt_scan_matcher.eng_loading_dock.param.yaml"
    />
    <arg name="launch_automatic_pose_initializer" value="false"/>
    <arg
      name="ndt_input_initial_pose_topic"
      value="/localization/pose_twist_fusion_filter/biased_pose_with_covariance_lidar_time"
    />
  </include>

  <node
    pkg="eng_loading_dock_sensor_kit_launch"
    exec="biased_pose_lidar_time_sync.py"
    name="eng_dock_biased_pose_lidar_time_sync"
    output="both"
  >
    <param name="use_sim_time" value="true"/>
  </node>

  <node
    pkg="eng_loading_dock_sensor_kit_launch"
    exec="dedupe_vector_map_markers.py"
    name="eng_dock_dedupe_vector_map_markers"
    output="both"
  >
    <param name="use_sim_time" value="true"/>
    <param name="input_topic" value="/map/vector_map_marker"/>
    <param name="output_topic" value="/map/vector_map_marker_viz"/>
  </node>

  <!-- After GNSS velocity + lidar relay are warm, seed EKF; NDT scan matcher refines. -->
  <node
    pkg="eng_loading_dock_sensor_kit_launch"
    exec="initialize_after_ready.py"
    name="eng_dock_initialize_after_ready"
    output="both"
  >
    <param name="use_sim_time" value="true"/>
    <param
      name="biased_pose_topic"
      value="/localization/pose_twist_fusion_filter/biased_pose_with_covariance"
    />
  </node>
</launch>
