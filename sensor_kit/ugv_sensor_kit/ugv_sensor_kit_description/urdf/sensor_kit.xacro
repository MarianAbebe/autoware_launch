<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">

    <xacro:include filename="$(find pandar_description)/urdf/pandar_ot128.xacro"/>
    <xacro:include filename="$(find ugv_sensor_kit_description)/sensor/camera/urdf/monocular_camera.xacro"/>
    <xacro:include filename="$(find ugv_sensor_kit_description)/sensor/imu/urdf/imu.xacro"/>

    <xacro:arg
      name="config_dir"
      default="$(find ugv_sensor_kit_description)/config"
    />

    <xacro:property
      name="sensor_kit_base_link"
      value="sensor_kit_base_link"
    />

    <!-- Mount the complete sensor kit to the vehicle -->
    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>

    <link name="${sensor_kit_base_link}"/>

    <xacro:property
      name="calibration"
      value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"
    />

    <!-- Hesai Pandar 128 LiDAR -->
    <xacro:PandarOT-128
      name="pandar128"
      parent="${sensor_kit_base_link}"
      x="${calibration['sensor_kit_base_link']['pandar128_base_link']['x']}"
      y="${calibration['sensor_kit_base_link']['pandar128_base_link']['y']}"
      z="${calibration['sensor_kit_base_link']['pandar128_base_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['pandar128_base_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['pandar128_base_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['pandar128_base_link']['yaw']}"
    />

    <!-- Lucid Triton2 cameras -->
    <xacro:monocular_camera_macro
      name="lucid_0_camera"
      parent="${sensor_kit_base_link}"
      namespace=""
      x="${calibration['sensor_kit_base_link']['lucid_0_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['lucid_0_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['lucid_0_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['lucid_0_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['lucid_0_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['lucid_0_camera_link']['yaw']}"
      fps="30"
      width="2448"
      height="2048"
      fov="1.3"
    />

    <xacro:monocular_camera_macro
      name="lucid_1_camera"
      parent="${sensor_kit_base_link}"
      namespace=""
      x="${calibration['sensor_kit_base_link']['lucid_1_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['lucid_1_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['lucid_1_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['lucid_1_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['lucid_1_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['lucid_1_camera_link']['yaw']}"
      fps="30"
      width="2448"
      height="2048"
      fov="1.3"
    />

    <xacro:monocular_camera_macro
      name="lucid_2_camera"
      parent="${sensor_kit_base_link}"
      namespace=""
      x="${calibration['sensor_kit_base_link']['lucid_2_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['lucid_2_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['lucid_2_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['lucid_2_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['lucid_2_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['lucid_2_camera_link']['yaw']}"
      fps="30"
      width="2448"
      height="2048"
      fov="1.3"
    />

    <!-- FLIR Blackfly S cameras -->
    <xacro:monocular_camera_macro
      name="blackfly_0_camera"
      parent="${sensor_kit_base_link}"
      namespace=""
      x="${calibration['sensor_kit_base_link']['blackfly_0_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['blackfly_0_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['blackfly_0_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['blackfly_0_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['blackfly_0_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['blackfly_0_camera_link']['yaw']}"
      fps="30"
      width="1440"
      height="1080"
      fov="1.3"
    />

    <xacro:monocular_camera_macro
      name="blackfly_1_camera"
      parent="${sensor_kit_base_link}"
      namespace=""
      x="${calibration['sensor_kit_base_link']['blackfly_1_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['blackfly_1_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['blackfly_1_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['blackfly_1_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['blackfly_1_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['blackfly_1_camera_link']['yaw']}"
      fps="30"
      width="1440"
      height="1080"
      fov="1.3"
    />

    <!-- Xsens MTi-7 -->
    <xacro:imu_macro
      name="xsens"
      parent="${sensor_kit_base_link}"
      namespace=""
      x="${calibration['sensor_kit_base_link']['xsens_link']['x']}"
      y="${calibration['sensor_kit_base_link']['xsens_link']['y']}"
      z="${calibration['sensor_kit_base_link']['xsens_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['xsens_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['xsens_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['xsens_link']['yaw']}"
      fps="100"
    />

    <!-- NovAtel GNS-0850 antenna 1 -->
    <joint name="novatel_gns0850_0_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['novatel_gns0850_0_link']['x']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_0_link']['y']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_0_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['novatel_gns0850_0_link']['roll']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_0_link']['pitch']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_0_link']['yaw']}"
      />
      <parent link="${sensor_kit_base_link}"/>
      <child link="novatel_gns0850_0_link"/>
    </joint>
    <link name="novatel_gns0850_0_link"/>

    <!-- NovAtel GNS-0850 antenna 2 -->
    <joint name="novatel_gns0850_1_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['novatel_gns0850_1_link']['x']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_1_link']['y']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_1_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['novatel_gns0850_1_link']['roll']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_1_link']['pitch']}
             ${calibration['sensor_kit_base_link']['novatel_gns0850_1_link']['yaw']}"
      />
      <parent link="${sensor_kit_base_link}"/>
      <child link="novatel_gns0850_1_link"/>
    </joint>
    <link name="novatel_gns0850_1_link"/>

    <!-- u-blox GNSS antenna -->
    <joint name="ublox_gnss_antenna_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['ublox_gnss_antenna_link']['x']}
             ${calibration['sensor_kit_base_link']['ublox_gnss_antenna_link']['y']}
             ${calibration['sensor_kit_base_link']['ublox_gnss_antenna_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['ublox_gnss_antenna_link']['roll']}
             ${calibration['sensor_kit_base_link']['ublox_gnss_antenna_link']['pitch']}
             ${calibration['sensor_kit_base_link']['ublox_gnss_antenna_link']['yaw']}"
      />
      <parent link="${sensor_kit_base_link}"/>
      <child link="ublox_gnss_antenna_link"/>
    </joint>
    <link name="ublox_gnss_antenna_link"/>

  </xacro:macro>
</robot>
